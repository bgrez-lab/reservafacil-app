{
  "name": "reservafacil-spa",
  "version": "1.0.0",
  "description": "Sistema de reservas de atención y gestión de citas - ReservaFácil SpA",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed:admin": "node scripts/seed-admin.js",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "reservas",
    "citas",
    "devsecops"
  ],
  "author": "ReservaFácil",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^7.0.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
