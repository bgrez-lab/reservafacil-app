{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    "node_modules/",
    "coverage/",
    "public/js/"
  ],
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^next$" }],
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"]
  }
}
