<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - ReservaFácil SpA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/admin/dashboard">ReservaFácil SpA — Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/admin/reservas">Reservas</a></li>
                    <li class="nav-item"><a class="nav-link" href="/admin/usuarios">Usuarios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                    <li class="nav-item">
                        <form action="/logout" method="POST" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="nav-link btn btn-link">Cerrar Sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        <h2 class="mb-4">Panel de Control</h2>

        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="feature-card text-center">
                    <div class="stat-value"><%= totalReservas %></div>
                    <div class="stat-label mt-2">Total reservas</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card text-center">
                    <div class="stat-value" style="color: var(--color-signal-gold);"><%= reservasPendientes %></div>
                    <div class="stat-label mt-2">Pendientes</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card text-center">
                    <div class="stat-value" style="color: var(--color-recovery-green);"><%= totalUsuarios %></div>
                    <div class="stat-label mt-2">Clientes</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card text-center">
                    <div class="stat-value" style="color: var(--color-metric-blue);"><%= reservasHoy %></div>
                    <div class="stat-label mt-2">Hoy</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="mb-0">Acciones Rápidas</h3>
            </div>
            <div class="card-body">
                <a href="/admin/reservas" class="btn btn-primary me-2">Gestionar Reservas</a>
                <a href="/admin/usuarios" class="btn btn-secondary">Ver Usuarios</a>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
