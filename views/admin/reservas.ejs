<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionar Reservas - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/admin/dashboard">ReservaFácil SpA — Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/admin/dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/admin/usuarios">Usuarios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                    <li class="nav-item">
                        <form action="/logout" method="POST" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="nav-link btn btn-link">Cerrar Sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        <h2 class="mb-4">Todas las Reservas</h2>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Cliente</th>
                                <th>Email</th>
                                <th>Servicio</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% reservas.forEach(reserva => { %>
                                <tr>
                                    <td><%= reserva.id %></td>
                                    <td><%= reserva.usuario %></td>
                                    <td><%= reserva.email %></td>
                                    <td><%= reserva.servicio %></td>
                                    <td><%= reserva.fecha.toISOString().split('T')[0] %></td>
                                    <td><%= reserva.hora %></td>
                                    <td>
                                        <span class="badge bg-<%= reserva.estado === 'confirmada' ? 'success' : reserva.estado === 'pendiente' ? 'warning' : reserva.estado === 'cancelada' ? 'danger' : 'secondary' %>">
                                            <%= reserva.estado %>
                                        </span>
                                    </td>
                                    <td>
                                        <form action="/admin/reservas/estado/<%= reserva.id %>" method="POST" style="display:inline;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <select name="estado" class="form-select form-select-sm" style="width:auto;display:inline;" data-autosubmit>
                                                <option value="pendiente" <%= reserva.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                                                <option value="confirmada" <%= reserva.estado === 'confirmada' ? 'selected' : '' %>>Confirmada</option>
                                                <option value="completada" <%= reserva.estado === 'completada' ? 'selected' : '' %>>Completada</option>
                                                <option value="cancelada" <%= reserva.estado === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
                                            </select>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/app.js"></script>
</body>
</html>
