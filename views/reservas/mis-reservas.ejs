<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Reservas - ReservaFácil SpA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">ReservaFácil SpA</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/reservas/nueva">Nueva Reserva</a></li>
                    <li class="nav-item">
                        <form action="/logout" method="POST" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="nav-link btn btn-link">Cerrar Sesión</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Mis Reservas</h2>
            <a href="/reservas/nueva" class="btn btn-primary">Nueva Reserva</a>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <% if (reservas.length === 0) { %>
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="mb-2">Aún no tienes reservas</h3>
                    <p class="mb-4">Solicita tu primera reserva en unos segundos.</p>
                    <a href="/reservas/nueva" class="btn btn-primary">Crear reserva</a>
                </div>
            </div>
        <% } else { %>
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Servicio</th>
                                    <th>Fecha</th>
                                    <th>Hora</th>
                                    <th>Duración</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% reservas.forEach(reserva => { %>
                                    <tr>
                                        <td><%= reserva.servicio %></td>
                                        <td><%= reserva.fecha.toISOString().split('T')[0] %></td>
                                        <td><%= reserva.hora %></td>
                                        <td><%= reserva.duracion_minutos %> min</td>
                                        <td>
                                            <span class="badge bg-<%= reserva.estado === 'confirmada' ? 'success' : reserva.estado === 'pendiente' ? 'warning' : reserva.estado === 'cancelada' ? 'danger' : 'secondary' %>">
                                                <%= reserva.estado %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (reserva.estado !== 'cancelada' && reserva.estado !== 'completada') { %>
                                                <form action="/reservas/cancelar/<%= reserva.id %>" method="POST" style="display:inline;" data-confirm="¿Estás seguro de cancelar esta reserva?">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-danger">Cancelar</button>
                                                </form>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </main>

    <script src="/js/app.js"></script>
</body>
</html>
