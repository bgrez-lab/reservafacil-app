<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Chatbot - ReservaFácil SpA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">ReservaFácil SpA</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contacto">Contacto</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="card">
            <div class="card-header">
                <h2 class="mb-0">Chatbot de Atención</h2>
            </div>
            <div class="card-body">
                <div id="chat" class="mb-3" style="max-height: 360px; overflow-y: auto; background: var(--color-paper-white); border-radius: 16px; padding: 16px;">
                    <div class="alert alert-info">Hola, soy el asistente de ReservaFácil. ¿En qué puedo ayudarte?</div>
                </div>
                <div class="d-flex gap-2 mb-4">
                    <input type="text" id="pregunta" class="form-control" placeholder="Escribe tu consulta...">
                    <button type="button" class="btn btn-primary" id="enviar">Enviar</button>
                </div>

                <% if (categorias && categorias.length) { %>
                    <div class="mb-4">
                        <h4>Categorías</h4>
                        <div class="d-flex flex-wrap gap-2">
                            <% categorias.forEach(cat => { %>
                                <button type="button" class="btn btn-secondary btn-sm categoria-btn" data-categoria="<%= cat %>"><%= cat %></button>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <div class="mb-4">
                    <h4>Preguntas frecuentes</h4>
                    <div class="accordion" id="faqAccordion">
                        <% qas.forEach((qa, index) => { %>
                            <div class="accordion-item" style="border:0; margin-bottom: 8px; border-radius: 16px; overflow: hidden;">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= index %>">
                                        <%= qa.pregunta %>
                                    </button>
                                </h2>
                                <div id="faq<%= index %>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body"><%= qa.respuesta %></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <div class="text-center">
                    <button type="button" class="btn btn-secondary" id="contactar">Hablar con un ejecutivo</button>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/chatbot.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
