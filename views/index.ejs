<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">ReservaFácil SpA</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <% if (userId) { %>
                        <li class="nav-item">
                            <span class="navbar-text me-3">Hola, <%= nombre %></span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/reservas/nueva">Nueva Reserva</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/reservas/mis-reservas">Mis Reservas</a>
                        </li>
                        <% if (rol === 'admin') { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin/dashboard">Panel Admin</a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">Cerrar Sesión</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Iniciar Sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/registro">Registrarse</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-5">
        <div class="row">
            <div class="col-lg-12 text-center">
                <h1 class="display-4 mb-4">Bienvenido a ReservaFácil SpA</h1>
                <p class="lead mb-5">Sistema de reservas de atención y gestión de citas</p>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title">Para Clientes</h5>
                        <p class="card-text">Regístrate, consulta disponibilidad, crea y gestiona tus propias reservas de forma independiente.</p>
                        <% if (!userId) { %>
                            <a href="/registro" class="btn btn-primary">Registrarse</a>
                        <% } else { %>
                            <a href="/reservas/nueva" class="btn btn-primary">Crear Reserva</a>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title">Gestión Profesional</h5>
                        <p class="card-text">Panel administrativo para gestionar agenda global, supervisar turnos y revisar registros del sistema.</p>
                        <% if (userId && rol === 'admin') { %>
                            <a href="/admin/dashboard" class="btn btn-success">Ir al Panel</a>
                        <% } else if (userId) { %>
                            <p class="text-muted">Requiere permisos de administrador</p>
                        <% } else { %>
                            <p class="text-muted">Inicia sesión para acceder</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-light text-center text-lg-start mt-5">
        <div class="text-center p-3">
            © 2026 ReservaFácil SpA - Proyecto Final DevSecOps
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
