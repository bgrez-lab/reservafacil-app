# Configuración de MongoDB (obligatorio)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/reservafacil

# Configuración de sesión/JWT (obligatorio en producción)
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
SESSION_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Opcionales
