# Configuración de la base de datos
DATABASE_URL=postgresql://user:password@host:5432/reservafacil

# Configuración de sesión (obligatorio en producción)
SESSION_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Configuración del servidor
PORT=3000
NODE_ENV=development

